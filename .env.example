# ============================================================
# Supabase Configuration
# ============================================================
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ============================================================
# Resend Email Configuration
# ============================================================
VITE_RESEND_API_KEY=re_your-resend-api-key-here

# ============================================================
# Application URLs
# ============================================================
VITE_APP_URL=http://localhost:5173
VITE_DISCOVERY_URL=/discovery

# ============================================================
# Calendly Links (for Email 3 CTAs)
# ============================================================
VITE_CALENDLY_CONSULTATION=https://calendly.com/your-team/consultation
VITE_PROGRAM_APPLICATION_URL=https://your-app.com/apply

# ============================================================
# Email Configuration
# ============================================================
VITE_SENDER_EMAIL=hello@digitalcreativeshub.com
VITE_REPLY_TO_EMAIL=hello@digitalcreativeshub.com

# ============================================================
# Optional: Email Scheduling Service
# If using Inngest or Trigger.dev for email scheduling
# ============================================================
INNGEST_API_KEY=optional-inngest-key
TRIGGER_API_KEY=optional-trigger-dev-key
